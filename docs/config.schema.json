{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/cricket-profile-readme/config.schema.json",
  "title": "Cricket Profile README configuration",
  "description": "Editor-facing schema for config.json. Mirrors the runtime validation in src/config.mjs; see docs/CONFIG.md for prose.",
  "type": "object",
  "required": ["github"],
  "properties": {
    "$schema": { "type": "string" },

    "github": {
      "type": "object",
      "required": ["username"],
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "description": "Whose data to fetch. The build fails on the placeholder value.",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$|^__SET_YOUR_GITHUB_USERNAME__$"
        },
        "excludeRepos": { "type": "array", "items": { "type": "string" } },
        "excludeLanguages": { "type": "array", "items": { "type": "string" } },
        "includeForks": { "type": "boolean", "default": false }
      }
    },

    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "description": "Hero title. Auto-scales down past 8/12/16 characters." },
        "capNumber": { "type": "string", "default": "404" },
        "role": { "type": "string" },
        "tagline": { "type": "string", "description": "~46 characters fits the hero." },
        "homeGround": { "type": "string" },
        "debutYear": { "type": ["integer", "null"], "description": "Unused; debut is derived from your first contribution." },
        "socials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkedin": { "type": "string" },
            "twitter": { "type": "string" },
            "website": { "type": "string" },
            "email": { "type": "string" }
          }
        }
      }
    },

    "bowling": {
      "type": "array",
      "description": "Delivery types by category. Usage is verified against your real repositories.",
      "items": {
        "type": "object",
        "required": ["category", "deliveries"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string" },
          "deliveries": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/tech" }
          }
        }
      }
    },

    "kit": {
      "type": "array",
      "description": "Stack, grouped as kit compartments.",
      "items": {
        "type": "object",
        "required": ["piece", "items"],
        "additionalProperties": false,
        "properties": {
          "piece": { "type": "string" },
          "sub": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/tech" }
          }
        }
      }
    },

    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["auto", "manual"], "default": "auto" },
        "count": { "type": "integer", "minimum": 1, "maximum": 8, "default": 4 },
        "pin": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Repository names, in display order. Only read when mode is \"manual\"."
        }
      }
    },

    "trophies": {
      "type": "array",
      "description": "Declared certifications and awards. Live milestones are added automatically.",
      "items": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "maxLength": 40 },
          "issuer": { "type": "string" },
          "year": { "type": ["string", "integer"] },
          "url": { "type": "string" }
        }
      }
    },

    "goals": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Rendered verbatim in the footer and quoted in the commentary."
    },

    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cacheBust": {
          "type": "boolean",
          "default": true,
          "description": "Leave enabled. Without it, GitHub's image proxy serves stale scenes after a rebuild."
        },
        "theme": { "type": "string", "default": "night-match" }
      }
    }
  },

  "patternProperties": {
    "^_comment": { "type": "string", "description": "Inline note; ignored by the loader." }
  },
  "additionalProperties": false,

  "definitions": {
    "tech": {
      "type": "object",
      "required": ["name", "keywords"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Display name. Truncated past ~12 characters." },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Matched on word boundaries against repository languages, topics, names and descriptions."
        }
      }
    }
  }
}
