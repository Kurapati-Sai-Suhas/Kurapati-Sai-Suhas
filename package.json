{
  "name": "cricket-profile-readme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A retro pixel-art cricket World Cup match, generated as a GitHub profile README from live GitHub API data.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/index.mjs",
    "build:offline": "node src/index.mjs --offline",
    "setup": "node scripts/setup.mjs",
    "check": "node --check src/index.mjs && node scripts/lint-assets.mjs",
    "preview": "node scripts/preview.mjs --open",
    "topics": "node scripts/suggest-topics.mjs",
    "prompts": "node scripts/project-prompts.mjs"
  },
  "keywords": [
    "github-profile-readme",
    "pixel-art",
    "svg",
    "cricket",
    "github-actions"
  ],
  "license": "MIT"
}
